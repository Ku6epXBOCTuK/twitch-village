{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/dist-assets",
			"!**/.turbo",
			"!**/*.log",
			"!**/*.yaml",
			"!**/*.yml"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentScriptAndStyle": true,
			"selfCloseVoidElements": "always"
		}
	},
	"markdown": {
		"formatter": {
			"proseWrap": "always",
			"indentStyle": "space",
			"indentWidth": 2
		}
	},
	"overrides": [
		{
			"includes": ["**/*.md"],
			"javascript": {
				"formatter": {
					"indentStyle": "space"
				}
			},
			"json": {
				"formatter": {
					"indentStyle": "space"
				}
			},
			"css": {
				"formatter": {
					"indentStyle": "space"
				}
			},
			"html": {
				"formatter": {
					"indentStyle": "space"
				}
			},
			"markdown": {
				"formatter": {
					"indentStyle": "space"
				}
			}
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
