{
	"name": "@tv/widget-shooting-words",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./constants": "./src/constants.ts",
		"./worker": "./src/worker.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --reporter=../../tools/vitest-failures-first.ts --passWithNoTests",
		"test:watch": "vitest watch --reporter=../../tools/vitest-failures-first.ts --passWithNoTests",
		"lint": "eslint src",
		"assets": "node scripts/prepare-assets.mjs && assetpack && node scripts/fix-manifest.mjs"
	},
	"dependencies": {
		"@tv/protocol": "workspace:*"
	},
	"devDependencies": {
		"@assetpack/core": "^1.7.0",
		"sharp": "^0.34.5"
	}
}
